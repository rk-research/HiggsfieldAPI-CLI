# Higgsfield API credentials
# The dashboard provides one API key as ID:SECRET. Split it at the colon,
# then put the two parts into the variables below. Do not paste the full
# ID:SECRET value into either variable.
# Copy this file to .env and replace the placeholders.

HF_API_KEY_ID=your_key_id_here
HF_API_KEY_SECRET=your_key_secret_here

# Optional process-environment override only; this CLI does not read it from .env.
# Use only a trusted HTTPS endpoint because the SDK sends the API key there.
# HF_API_BASE_URL=https://api.higgsfield.ai
